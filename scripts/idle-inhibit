#!/bin/sh

state_dir="${XDG_RUNTIME_DIR:-/tmp}/dwl-idle-inhibit"
manual_state="$state_dir/manual"

start_idle()
{
	systemctl --user start swayidle.service
}

case ${1:-toggle} in
	on)
		mkdir -p "$state_dir"
		: > "$manual_state"
		start_idle
		wlopm --on "*" 2>/dev/null
		;;

	off)
		rm -f "$manual_state"
		start_idle
		;;

	toggle)
		if [ -f "$manual_state" ]; then
			rm -f "$manual_state"
			start_idle
		else
			mkdir -p "$state_dir"
			: > "$manual_state"
			start_idle
			wlopm --on "*" 2>/dev/null
		fi
		;;

	status)
		if [ -f "$manual_state" ]; then
			printf '%s\n' "on"
		else
			printf '%s\n' "off"
		fi
		;;

	*)
		printf 'usage: %s [on|off|toggle|status]\n' "$0" >&2
		exit 2
		;;
esac
