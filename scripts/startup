#!/bin/sh

export XDG_CURRENT_DESKTOP=dwl
export XDG_SESSION_DESKTOP=dwl
export XDG_SESSION_TYPE=wayland

# Give D-Bus and systemd services the current Wayland environment.
dbus-update-activation-environment --systemd \
	WAYLAND_DISPLAY \
	XDG_CURRENT_DESKTOP \
	XDG_SESSION_DESKTOP \
	XDG_SESSION_TYPE

systemctl --user import-environment \
	WAYLAND_DISPLAY \
	XDG_CURRENT_DESKTOP \
	XDG_SESSION_DESKTOP \
	XDG_SESSION_TYPE

# Restart the portals with the correct dwl environment.
systemctl --user restart \
	xdg-desktop-portal-wlr.service \
	xdg-desktop-portal.service

# Authentication prompts.
if ! pgrep -f \
		'^/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1$' \
		>/dev/null; then
	/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi

# Notifications.
if ! pgrep -x mako >/dev/null; then
	mako &
fi

# Wallpaper daemon.
if ! pgrep -x awww-daemon >/dev/null; then
	awww-daemon &
fi

# Clipboard history for text and images.
wl-paste --type text --watch cliphist store &
wl-paste --type image --watch cliphist store &

# Locking, display power management, and suspend. Restart after importing the
# current Wayland environment so the service always targets this dwl session.
systemctl --user restart swayidle.service

# Remove processes left behind by an earlier session.
pkill -f "^/bin/sh $HOME/dotfiles/somebar/scripts/status.sh$" \
	2>/dev/null
pkill -x somebar 2>/dev/null
pkill -f '[n]ow-playing --watch' 2>/dev/null

# Start these after their daemons have had time to initialize.
(
	sleep 1

	"$HOME/dotfiles/dwl/scripts/wallpaper" \
		"$HOME/Pictures/Wallpapers/current"

	"$HOME/dotfiles/somebar/scripts/now-playing" --watch \
		</dev/null \
		>/tmp/now-playing.log 2>&1 &

	exec "$HOME/dotfiles/somebar/scripts/status.sh"
) &

# Somebar must stay in the foreground to receive dwl's IPC stream.
exec somebar > /tmp/somebar.log 2>&1

# Pause playback and stop bar helpers when leaving dwl.
mpc pause >/dev/null 2>&1
pkill -f '[n]ow-playing --watch' 2>/dev/null
pkill -f "^/bin/sh $HOME/dotfiles/somebar/scripts/status.sh$" \
	2>/dev/null
