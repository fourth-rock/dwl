#!/bin/sh

state_dir="${XDG_RUNTIME_DIR:-/tmp}/dwl-idle-inhibit"
manual_state="$state_dir/manual"

start_idle()
{
	if [ -d "$state_dir" ] && find "$state_dir" -type f -print -quit | grep -q .; then
		return
	fi

	if ! pgrep -x swayidle >/dev/null; then
		"$HOME/dotfiles/dwl/scripts/idle" \
			> /tmp/swayidle.log 2>&1 &
	fi
}

stop_idle()
{
	pkill -x swayidle 2>/dev/null
}

case ${1:-toggle} in
	on)
		mkdir -p "$state_dir"
		: > "$manual_state"
		stop_idle
		;;

	off)
		rm -f "$manual_state"
		start_idle
		;;

	toggle)
		if [ -f "$manual_state" ]; then
			rm -f "$manual_state"
			start_idle
		else
			mkdir -p "$state_dir"
			: > "$manual_state"
			stop_idle
		fi
		;;

	status)
		if [ -f "$manual_state" ]; then
			printf '%s\n' "on"
		else
			printf '%s\n' "off"
		fi
		;;

	*)
		printf 'usage: %s [on|off|toggle|status]\n' "$0" >&2
		exit 2
		;;
esac
